# ---- Public (shipped to the browser) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# Use the Supabase pooled connection string (port 6543, transaction mode) on Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agencyos
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=attachments
# Optional: emails are skipped (and logged) when unset.
RESEND_API_KEY=
EMAIL_FROM="AgencyOS <notifications@yourdomain.com>"
# Random string, at least 32 characters. Protects /api/cron/* routes.
CRON_SECRET=replace-with-at-least-32-random-characters
